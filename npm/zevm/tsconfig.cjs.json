{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": false,
    "declarationMap": false,
    "module": "CommonJS",
    "moduleResolution": "Node",
    // TypeScript 6 deprecates moduleResolution=node10, but this config intentionally
    // emits CommonJS for the dist-cjs build, which still requires node10 resolution.
    "ignoreDeprecations": "6.0",
    "outDir": "dist-cjs"
  },
  "include": [
    "src/rlp.ts",
    "src/receipt.ts",
    "src/receipt-manager.ts",
    "src/evm-error.ts",
    "src/common.ts",
    "src/evm.ts",
    "src/trie.ts",
    "src/tx.ts",
    "src/txpool.ts",
    "src/util.ts",
    "src/statemanager.ts"
  ]
}
