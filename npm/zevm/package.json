{
  "name": "@evmts/zevm",
  "version": "0.1.0",
  "description": "Native ZEVM execution and light-client bindings",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/index.js",
    "native/zevm.node",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node --check src/index.js",
    "publish:all": "node scripts/publish-all.cjs",
    "publish:all:dry": "node scripts/publish-all.cjs --dry-run",
    "stage:artifacts": "node scripts/stage-artifacts.cjs",
    "smoke:native": "node scripts/smoke.cjs ../../zig-out/npm/native/zevm.node"
  },
  "dependencies": {},
  "optionalDependencies": {
    "@evmts/zevm-darwin-arm64": "0.1.0",
    "@evmts/zevm-darwin-x64": "0.1.0",
    "@evmts/zevm-freebsd-arm64": "0.1.0",
    "@evmts/zevm-freebsd-x64": "0.1.0",
    "@evmts/zevm-linux-arm64-gnu": "0.1.0",
    "@evmts/zevm-linux-arm64-musl": "0.1.0",
    "@evmts/zevm-linux-x64-gnu": "0.1.0",
    "@evmts/zevm-linux-x64-musl": "0.1.0",
    "@evmts/zevm-win32-arm64-msvc": "0.1.0",
    "@evmts/zevm-win32-ia32-msvc": "0.1.0",
    "@evmts/zevm-win32-x64-msvc": "0.1.0"
  },
  "devDependencies": {}
}
