  "on": [
    {
      "event": "issue.labeled:todo",
      "flow": "issue/poc",
      "description": "Build a failing regression and bounded fix for every maintainer-accepted TODO"
    },
    {
      "event": "change.opened",
      "flow": "checks/review",
      "description": "Review every Change across consensus, RPC, light client, memory, and build graph lenses"
    },
    {
      "event": "change.updated",
      "flow": "checks/review",
      "description": "Re-review every updated Change before maintainer merge"
    },
    {
      "event": "change.landed",
      "flow": [
        "wiki-refresh",
        "docs-publish"
      ],
      "description": "Verify the Obsidian wiki, mythical history, and docs bundle after every landing"
    },
    {
      "event": "github.push:main",
      "flow": [
        "wiki-refresh",
        "docs-publish"
      ],
      "description": "Keep wiki citations, llms.txt, and docs artifacts aligned with main"
    },
    {
      "event": "schedule:17 9 * * 1",
      "flow": "conformance-review",
      "description": "Weekly Monday conformance, native pin, and benchmark audit"
    }
  ],
  "github": {
    "mirror": "pull",
    "issues": "two-way",
    "changes": "send-upstream",
    "protectedPaths": [
      ".smithers",
      ".agents/uphill",
      ".github/workflows",
      "PACKAGE.ts",
      "build.zig",
      "build.zig.zon",
      "native-dependencies.json",
      "include/zevm.h",
      "src/c_bindings.zig",
      "src/tx_processor.zig",
      "src/consensus_verifier.zig",
      "src/hardfork_schedule.zig",
      "src/light_default_checkpoints.zig",
      "docs/specs/qualification",
      "spec/lean"
    ],
    "maintainers": [
      "roninjin10"
    ],
    "dailyTokens": 1000000000
  },
  "policy": {
    "lifecycle": {
      "docs": "evergreen",
      "tests": "evergreen"
    },
    "notifications": {
      "quietHours": []
    },
    "approvals": {
      "approve": "person",
      "merge": "person"
    }
  },
  "machine": {
    "vcpus": 4,
    "memoryMiB": 8192,
    "tools": [
      "zig",
      "cargo",
      "rustc",
      "cc",
      "node",
      "bun",
      "jq",
      "uphill"
    ]
  },
  "issueViews": [
    {
      "id": "triage",
      "title": "Needs triage",
      "state": "open",
      "labels": [
        "proposed"
      ]
    },
    {
      "id": "todo",
      "title": "Committed TODOs",
      "state": "open",
      "labels": [
        "todo"
      ]
    },
    {
      "id": "bugs",
      "title": "Open bugs",
      "state": "open",
      "labels": [
        "bug"
      ]
    },
    {
      "id": "consensus",
      "title": "Consensus & EVM",
      "state": "open",
      "labels": [
        "consensus"
      ]
    },
    {
      "id": "rpc",
      "title": "JSON-RPC parity",
      "state": "open",
      "labels": [
        "rpc"
      ]
    },
    {
      "id": "light-client",
      "title": "Beacon light client",
      "state": "open",
      "labels": [
        "light-client"
      ]
    },
    {
      "id": "exex-rebase",
      "title": "ExEx & rebase fork",
      "state": "open",
      "labels": [
        "exex"
      ]
    },
    {
      "id": "external-tests",
      "title": "External test suites",
      "state": "open",
      "labels": [
        "external-tests"
      ]
    }
  ],
  "issueTransitions": [
    {
      "id": "accept",
      "title": "Accept for discussion",
      "from": "proposed",
      "to": "accepted",
      "actor": "person"
    },
    {
      "id": "needs-repro",
      "title": "Needs minimal repro",
      "from": "proposed",
      "to": "needs-repro",
      "actor": "anyone"
    },
    {
      "id": "todo",
      "title": "Commit to TODO",
      "from": "accepted",
      "to": "todo",
      "actor": "person"
    },
    {
      "id": "wontfix",
      "title": "Decline proposal",
      "from": "proposed",
      "to": "wontfix",
      "actor": "person"
    }
  ],
  "contributes": {
    "triggers": [
      {
        "on": "github.push",
        "flow": "ci",
        "title": "ZEVM CI on main",
        "branches": [
          "main"
        ]
      },
      {
        "on": "github.pull_request",
        "flow": "ci",
        "title": "ZEVM CI on pull request"
      },
      {
        "on": "github.push",
        "flow": "uphill",
        "title": "Lighthouse backpressure audit on main",
        "branches": [
          "main"
        ]
      },
      {
        "on": "github.pull_request",
        "flow": "uphill",
        "title": "Lighthouse backpressure audit on pull request"
      },
      {
        "on": "github.push",
        "flow": "docs-publish",
        "title": "Verify and build ZEVM docs + llms.txt",
        "branches": [
          "main"
        ]
      },
      {
        "on": "github.push",
        "flow": "wiki-refresh",
        "title": "Verify ZEVM wiki and mythical history",
        "branches": [
          "main"
        ]
      },
      {
        "on": "github.push",
        "flow": "release-check",
        "title": "Validate release parity and qualification metadata",
        "tags": [
          "v*"
        ]
      },
      {
        "on": "cron",
        "flow": "uphill",
        "title": "Weekly backpressure and conformance audit",
        "cron": "17 9 * * 1",
        "timezone": "UTC",
        "overlap": "skip"
      }
    ]
  }
}
