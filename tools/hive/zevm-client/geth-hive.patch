+
+func (api *DebugAPI) GetRawBlockFromPeer(ctx context.Context, hash common.Hash) (hexutil.Bytes, error) {
+	if block := api.eth.blockchain.GetBlockByHash(hash); block != nil {
+		return rlp.EncodeToBytes(block)
+	}
+
+	peers := api.eth.handler.peers.all()
+	if len(peers) == 0 {
+		return nil, fmt.Errorf("no eth peers available")
+	}
+
+	var lastErr error
+	for _, peer := range peers {
+		block, err := api.getBlockFromPeer(ctx, peer, hash)
+		if err == nil {
+			return rlp.EncodeToBytes(block)
+		}
+		lastErr = err
+	}
+	return nil, lastErr
+}
+
+func (api *DebugAPI) getBlockFromPeer(ctx context.Context, peer *ethPeer, hash common.Hash) (*types.Block, error) {
+	ctx, cancel := context.WithTimeout(ctx, 2*time.Second)
+	defer cancel()
+
+	headerCh := make(chan *ethproto.Response)
+	headerReq, err := peer.Peer.RequestHeadersByHash(hash, 1, 0, false, headerCh)
+	if err != nil {
+		return nil, err
+	}
+	defer headerReq.Close()
+
+	var header *types.Header
+	select {
+	case <-ctx.Done():
+		return nil, ctx.Err()
+	case response := <-headerCh:
+		headers := *response.Res.(*ethproto.BlockHeadersRequest)
+		response.Done <- nil
+		if len(headers) != 1 {
+			return nil, fmt.Errorf("peer returned %d headers", len(headers))
+		}
+		header = headers[0]
+	}
+	if header.Hash() != hash {
+		return nil, fmt.Errorf("peer returned header %s for requested hash %s", header.Hash(), hash)
+	}
+
+	bodyCh := make(chan *ethproto.Response)
+	bodyReq, err := peer.Peer.RequestBodies([]common.Hash{hash}, bodyCh)
+	if err != nil {
+		return nil, err
+	}
+	defer bodyReq.Close()
+
+	select {
+	case <-ctx.Done():
+		return nil, ctx.Err()
+	case response := <-bodyCh:
+		bodies := *response.Res.(*ethproto.BlockBodiesResponse)
+		response.Done <- nil
+		if len(bodies) != 1 {
+			return nil, fmt.Errorf("peer returned %d bodies", len(bodies))
+		}
+		body := bodies[0]
+		block := types.NewBlockWithHeader(header).WithBody(types.Body{
+			Transactions: body.Transactions,
+			Uncles:       body.Uncles,
+			Withdrawals:  body.Withdrawals,
+		})
+		if block.Hash() != hash {
+			return nil, fmt.Errorf("peer returned body that reconstructs %s for requested hash %s", block.Hash(), hash)
+		}
+		return block, nil
+	}
 }
 
