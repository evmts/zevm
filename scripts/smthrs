#!/bin/sh
# Runs the Smithers CLI (`smthrs`) against this repository's
# .smithers/WORKSPACE.ts graph (root PACKAGE.ts, bench/**/PACKAGE.ts, .smithers/PACKAGE.ts).
#
# Usage:
#   scripts/smthrs ci '//...'
#   scripts/smthrs ci //:test //:fmt
#   scripts/smthrs ci '//bench/...'
#   scripts/smthrs target //.smithers:factory-write --write
#   scripts/smthrs explain //:build
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"

# Key Zig targets on the sibling native dependencies (see PACKAGE.ts).
node tools/native_deps_digest.mjs .native-deps.digest

if [ -n "${SMTHRS_BIN:-}" ] && [ -x "$SMTHRS_BIN" ]; then
  exec "$SMTHRS_BIN" "$@"
fi

if command -v smthrs >/dev/null 2>&1; then
  exec smthrs "$@"
fi

sibling="$root/../smithers/node_modules/.bin/smthrs"
if [ -x "$sibling" ]; then
  exec "$sibling" "$@"
fi

echo "error: smthrs not found on PATH or at $sibling (set SMTHRS_BIN to override, or run npx --package=@smthrs/cli smthrs)" >&2
exit 1
